    "8": [
      {
        "line": "3",
        "text": "\u0643\u0645\u0627 \u0647\u064a\u0627 \u0627\u0644\u0644\u0647 \u0633\u0628\u062d\u0627\u0646\u0647 \u0645\u0624\u0633\u0633\u0629 \u00ab\u0645\u0639\u0627\u0644\u0645 \u0627\u0644\u0633\u0646\u0646\u00bb \u0644\u062e\u062f\u0645\u0629 \u0639\u0644\u0645 \u0627\u0644\u0634\u064a\u062e \u0648\u0646\u0634\u0631\u0647 \u0645\u0646\u0630\n\u062a\u0623\u0633\u064a\u0633\u0647\u0627 \u0639\u0627\u0645 414737 \u0628\u0634\u062a\u0626 \u0627\u0644\u0637\u0631\u0642 \u0627\u0644\u0645\u062a\u0627\u062d\u0629\u00bb \u0648\u0647\u0627 \u0647\u064a -\u0628\u0641\u0636\u0644 \u0627\u0644\u0644\u0647- \u062a\u0628\u0634\u064e\u0651\u0631 \u0637\u0644\u0627\u0628\n\u0627\u0644\u0639\u0644\u0645 \u0648\u0645\u062d\u0628\u064a\u0651\u0647 \u0628\u0637\u0628\u0627\u0639\u0629 \u0643\u062a\u0627\u0628: \u0634\u0631\u062d \u0643\u0634\u0641 \u0627\u0644\u0634\u0628\u0647\u0627\u062a\u00bb."
      },
      {
        "line": "1",
        "text": "\u0645\u0645\u0627 \u062c\u0639\u0644 \u0644\u0647\u0630\u0647 \u0627\u0644\u0634\u0631\u0648\u062d \u0631\u0648\u0627\u062c\u0627 \u0628\u064a\u0646 \u0637\u0644\u0627\u0628 \u0627\u0644\u0639\u0644\u0645\u00bb \u0639\u0644\u0626 \u0627\u062e\u062a\u0644\u0627\u0641 \u0645\u0633\u062a\u0648\u064a\u0627\u062a\u0647\u0645."
